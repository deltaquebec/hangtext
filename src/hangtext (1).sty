	\hverse@temphindent=\hverse@hindent@default
	\hverse@tempvspace=\hverse@vspace@default
	\hverse@temptwidth=\hverse@twidth@default
	\hangtext@setkeys{hverse}{#1}%
	\hverse@checkmode
}
\def\hverse@noopt{%
	\hverse@temphindent=\hverse@hindent@default
	\hverse@tempvspace=\hverse@vspace@default
	\hverse@temptwidth=\hverse@twidth@default
	\hverse@checkmode
}

% check if we need minipage wrapper
\def\hverse@checkmode{%
	\hverse@useminipagefalse
	\ifvmode\else
	\ifdim\hverse@temptwidth<\maxdimen
	\hverse@useminipagetrue
	\fi
	\fi
	\ifhverse@useminipage
	\hverse@startminipage
	\else
	\hverse@start
	\fi
}

% minipage wrapper
\def\hverse@startminipage{%
	\begin{minipage}{\hverse@temptwidth}%
	\hangtext@resethang
	\hverse@start
}
\def\endhverse@minipage{%
	\hverse@end
	\end{minipage}%
}

\def\hverse@start{%
	\par
	\edef\hverse@savedvspace{\the\hverse@tempvspace}%
	\edef\hverse@savedhsize{\the\hsize}%
	\edef\hverse@savedlinewidth{\the\linewidth}%
	\edef\hverse@savedtextwidth{\the\textwidth}%
	\edef\hverse@savedcolumnwidth{\the\columnwidth}%
	\ifvmode\addvspace{\hverse@tempvspace}\fi
	% apply width constraint early
	\ifdim\hverse@temptwidth<\maxdimen
	\hsize=\hverse@temptwidth\relax
	\linewidth=\hverse@temptwidth\relax
	\textwidth=\hverse@temptwidth\relax
	\columnwidth=\hverse@temptwidth\relax
	\fi
	\hverse@firstlinetrue
	\edef\hverse@savedcumulativehang{\the\cumulativehang}%
	% only capture base state if we are top level (not nested)
	\ifdim\cumulativehang=0pt
	\setlength{\baseleftskip}{\leftskip}%
	\edef\hangtext@basetextedge{\the\dimexpr\@totalleftmargin+\leftskip\relax}%
	\fi
	% save paragraph parameters to restore later
	\edef\hverse@savedtotalleftmargin{\the\@totalleftmargin}%
	\edef\hverse@savedparskip{\the\parskip}%
	\edef\hverse@savedparindent{\the\parindent}%
	\edef\hverse@savedrightskip{\the\rightskip}%
	\advance\cumulativehang by \hverse@temphindent\relax
	% reduce the child measure
	\advance\hangtext@activelevel by 1\relax
	\advance\linewidth by -\hverse@temphindent\relax
	% adjust nested-material left margin to respect hverse indentation
	\setlength{\@totalleftmargin}{\dimexpr\hangtext@basetextedge+\cumulativehang\relax}%
	% paragraph parameters
	\parskip=0pt\relax
	\rightskip=0pt plus 1fil\relax % ragged-right to avoid overfulls in verse
	\parindent=0pt\relax
	% overwrite \everypar (no chaining) to avoid recursion; restore at end.
	\hverse@saved@everypar=\expandafter{\the\everypar}%
	\everypar{%
		\ifhverse@firstline
		\leftskip=\dimexpr\baseleftskip+\hverse@savedcumulativehang\relax
		\hverse@firstlinefalse
		\else
		\leftskip=\dimexpr\baseleftskip+\cumulativehang\relax
		\fi
		\hangindent=\hverse@temphindent\relax
		\hangafter=1\relax
	}%
	\obeylines
	\normalfont
	\frenchspacing
	\ignorespaces
}

\def\endhverse{%
	\ifhverse@useminipage
	\endhverse@minipage
	\else
	\hverse@end
	\fi
}

\def\hverse@end{%
	\par
	\everypar=\hverse@saved@everypar
	\setlength{\cumulativehang}{\hverse@savedcumulativehang}%
	% restore leftskip to base + restored cumulative hang
	\leftskip=\dimexpr\baseleftskip+\cumulativehang\relax
	% restore list left margin
	\setlength{\@totalleftmargin}{\hverse@savedtotalleftmargin}%
	% restore paragraph parameters
	\parskip=\hverse@savedparskip\relax
	\parindent=\hverse@savedparindent\relax
	\rightskip=\hverse@savedrightskip\relax
	\hsize=\hverse@savedhsize\relax
	\linewidth=\hverse@savedlinewidth\relax
	\textwidth=\hverse@savedtextwidth\relax
	\columnwidth=\hverse@savedcolumnwidth\relax
	\advance\hangtext@activelevel by -1\relax
	\ifnum\hangtext@activelevel<0 \hangtext@activelevel=0\relax\fi
	\ifvmode\addvspace{\hverse@savedvspace}\fi
	\ignorespacesafterend
}

\makeatother

