\newdimen\hversestar@hindent@default  \hversestar@hindent@default=\allttsubsequentindent
\newdimen\hversestar@vspace@default   \hversestar@vspace@default=0pt
\newdimen\hversestar@twidth@default   \hversestar@twidth@default=\maxdimen

% option state
\newdimen\hversestar@temphindent
\newdimen\hversestar@tempvspace
\newdimen\hversestar@temptwidth

