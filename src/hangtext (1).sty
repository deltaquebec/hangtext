\newcount\hversestar@stanzano
\newif\ifhversestar@firstline
\newif\ifhversestar@hadtext
\newif\ifhversestar@seenpar

% saved tokens
\newtoks\hversestar@saved@everypar

% flag for minipage mode
\newif\ifhversestar@useminipage

% keys
