\hangtext@defkey{hverse*}{vspace}{%
	\hangtext@setdim\hversestar@tempvspace{#1}%
}
\hangtext@defkey{hverse*}{twidth}{%
	\hangtext@setdim\hversestar@temptwidth{#1}%
	\ifdim\hversestar@temptwidth<1sp
		\PackageWarning{hangtext}{Nonpositive twidth ignored}%
		\hversestar@temptwidth=\maxdimen
	\fi
}

% env
\@namedef{hverse*}{%
	\@ifnextchar[{\hversestar@withopt}{\hversestar@noopt}%
}
\def\hversestar@withopt[#1]{%
	\hversestar@temphindent=\hversestar@hindent@default
	\hversestar@tempvspace=\hversestar@vspace@default
	\hversestar@temptwidth=\hversestar@twidth@default
	\hangtext@setkeys{hverse*}{#1}%
	\hversestar@checkmode
}
\def\hversestar@noopt{%
	\hversestar@temphindent=\hversestar@hindent@default
	\hversestar@tempvspace=\hversestar@vspace@default
	\hversestar@temptwidth=\hversestar@twidth@default
	\hversestar@checkmode
}

% check if we need minipage wrapper
\def\hversestar@checkmode{%
	\hversestar@useminipagefalse
	\ifvmode\else
	\ifdim\hversestar@temptwidth<\maxdimen
	\hversestar@useminipagetrue
	\fi
	\fi
	\ifhversestar@useminipage
	\hversestar@startminipage
	\else
	\hversestar@start
	\fi
}

% minipage wrapper
\def\hversestar@startminipage{%
	\begin{minipage}{\hversestar@temptwidth}%
	\hangtext@resethang
	\hversestar@start
}
\def\endhversestar@minipage{%
	\hversestar@end
	\end{minipage}%
}

\def\hversestar@start{%
	\par
	\edef\hversestar@savedvspace{\the\hversestar@tempvspace}%
	\edef\hversestar@savedhsize{\the\hsize}%
	\edef\hversestar@savedlinewidth{\the\linewidth}%
	\edef\hversestar@savedtextwidth{\the\textwidth}%
	\edef\hversestar@savedcolumnwidth{\the\columnwidth}%
	\ifvmode\addvspace{\hversestar@tempvspace}\fi
	% apply width constraint early
	\ifdim\hversestar@temptwidth<\maxdimen
	\hsize=\hversestar@temptwidth\relax
	\linewidth=\hversestar@temptwidth\relax
	\textwidth=\hversestar@temptwidth\relax
	\columnwidth=\hversestar@temptwidth\relax
	\fi
	% initialize stanza tracking
	\hversestar@stanzano=0
	\hversestar@firstlinetrue
	\hversestar@hadtextfalse
	\hversestar@seenparfalse
	\edef\hversestar@savedcumulativehang{\the\cumulativehang}%
	% only capture base state if we are top level (not nested)
	\ifdim\cumulativehang=0pt
	\setlength{\baseleftskip}{\leftskip}%
	\edef\hangtext@basetextedge{\the\dimexpr\@totalleftmargin+\leftskip\relax}%
	\fi
	% save paragraph parameters to restore later
	\edef\hversestar@savedtotalleftmargin{\the\@totalleftmargin}%
	\edef\hversestar@savedparskip{\the\parskip}%
	\edef\hversestar@savedparindent{\the\parindent}%
	\edef\hversestar@savedrightskip{\the\rightskip}%
	% no \linewidth reduction here
	\advance\hangtext@activelevel by 1\relax
	% adjust nested-material left margin to respect hverse* indentation
	\setlength{\@totalleftmargin}{\dimexpr\hangtext@basetextedge+\cumulativehang\relax}%
	% paragraph parameters
	\parskip=0pt\relax
	\rightskip=0pt plus 1fil\relax
	\parindent=0pt\relax
	% save and overwrite \everypar
	\hversestar@saved@everypar=\expandafter{\the\everypar}%
	\everypar{%
		% base position for current stanza
		\dimen0=\dimexpr\baseleftskip+\hversestar@savedcumulativehang\relax
		\advance\dimen0 by \hversestar@stanzano\hversestar@temphindent\relax
		\ifhversestar@firstline
		\leftskip=\dimen0\relax
		\hversestar@firstlinefalse
		\else
		\leftskip=\dimen0\relax
		\advance\leftskip by \hversestar@temphindent\relax
		\fi
	}%
	% custom \par
	\let\hversestar@saved@par\par
	\def\par{%
		\ifhmode
			\hversestar@hadtexttrue
			\hversestar@seenparfalse
			\@@par
		\else
			\ifhversestar@hadtext
				\ifhversestar@seenpar
					\hbox{}%
				\else
					\hversestar@seenpartrue
					\hbox{}%
					\advance\hversestar@stanzano by 1
					\hversestar@firstlinetrue
				\fi
			\fi
			\@@par
		\fi
	}%
	\obeylines
	\normalfont
	\frenchspacing
	\ignorespaces
}

\@namedef{endhverse*}{%
	\ifhversestar@useminipage
	\endhversestar@minipage
	\else
	\hversestar@end
	\fi
}

\def\hversestar@end{%
	\@@par  % primitive \par to bypass custom definition
	\let\par\hversestar@saved@par
	\everypar=\hversestar@saved@everypar
	\setlength{\cumulativehang}{\hversestar@savedcumulativehang}%
	% restore leftskip to base + restored cumulative hang (for parent)
	\leftskip=\dimexpr\baseleftskip+\cumulativehang\relax
	% restore list left margin
	\setlength{\@totalleftmargin}{\hversestar@savedtotalleftmargin}%
	% restore paragraph parameters
	\parskip=\hversestar@savedparskip\relax
	\parindent=\hversestar@savedparindent\relax
	\rightskip=\hversestar@savedrightskip\relax
	\hsize=\hversestar@savedhsize\relax
	\linewidth=\hversestar@savedlinewidth\relax
	\textwidth=\hversestar@savedtextwidth\relax
	\columnwidth=\hversestar@savedcolumnwidth\relax
	\advance\hangtext@activelevel by -1\relax
	\ifnum\hangtext@activelevel<0 \hangtext@activelevel=0\relax\fi
	\ifvmode\addvspace{\hversestar@savedvspace}\fi
	\ignorespacesafterend
}

\makeatother
