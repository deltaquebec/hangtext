\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hangtext}[2026/07/28 v3.0 Hanging indentation environments]

%  keyval
\long\def\hangtext@defkey#1#2{\@namedef{hangtext@kv@#1@#2}##1}

\def\hangtext@setkeys#1#2{%
	\def\hangtext@kv@grp{#1}%
	\@for\hangtext@kv@raw:=#2\do{%
		\ifx\hangtext@kv@raw\@empty\else
		\expandafter\hangtext@kvsplit\hangtext@kv@raw==\hangtext@kv@end
		\fi}}
\def\hangtext@kvsplit#1=#2=#3\hangtext@kv@end{%
	\hangtext@trimkey{#1}%
	\ifx\hangtext@kvkey\@empty\else
	\@ifundefined{hangtext@kv@\hangtext@kv@grp @\hangtext@kvkey}%
	{\PackageWarning{hangtext}{Unknown key '\hangtext@kvkey'}}%
	{\@nameuse{hangtext@kv@\hangtext@kv@grp @\hangtext@kvkey}{#2}}%
	\fi}
% strip all spaces from key
\def\hangtext@trimkey#1{%
	\edef\hangtext@kvkey{\zap@space#1 \@empty}}

\def\hangtext@setdim#1#2{%
	\def\hangtext@kv@val{#2}%
	\ifx\hangtext@kv@val\@empty
		\PackageWarning{hangtext}{Empty value for key '\hangtext@kvkey' ignored}%
	\else
		#1=\dimexpr #2\relax
	\fi}

\newlength{\cumulativehang}
\setlength{\cumulativehang}{0pt}

% track "true base" leftskip from surrounding constructs (like theorems)
\newlength{\baseleftskip}
\setlength{\baseleftskip}{0pt}

% depth for the list patch (nesting)
\newcount\hangtext@activelevel
\hangtext@activelevel=0

% base text edge captured on entry
\def\hangtext@basetextedge{0pt}

\makeatletter
% fallback if caller has not defined this....
\@ifundefined{allttsubsequentindent}{%
	\newdimen\allttsubsequentindent
	\allttsubsequentindent=2em
}{}

\newcommand*\hangtext@resethang{%
	\cumulativehang=0pt\relax
	\baseleftskip=0pt\relax
	\hangtext@activelevel=0\relax
}
\makeatother


\makeatletter

% defaults
\newdimen\hprose@hindent@default  \hprose@hindent@default=2em
\newdimen\hprose@vspace@default   \hprose@vspace@default=0pt
\newdimen\hprose@twidth@default   \hprose@twidth@default=\maxdimen

% state
\newdimen\hprose@temphindent
\newdimen\hprose@tempvspace
\newdimen\hprose@temptwidth
\def\hprose@tempjustification{}

% saved tokens
\newtoks\hprose@saved@everypar

% flag for minipage mode
\newif\ifhprose@useminipage

% flag for first paragraph (local to each hprose group; controls \parindent pullback)
\newif\ifhprose@firstpar

% keys
\hangtext@defkey{hprose}{hindent}{%
	\hangtext@setdim\hprose@temphindent{#1}%
	\ifdim\hprose@temphindent<0pt \hprose@temphindent=0pt\fi
}
\hangtext@defkey{hprose}{vspace}{%
	\hangtext@setdim\hprose@tempvspace{#1}%
}
\hangtext@defkey{hprose}{justification}{%
	\def\hprose@tempjustification{#1}%
}
\hangtext@defkey{hprose}{twidth}{%
	\hangtext@setdim\hprose@temptwidth{#1}%
	\ifdim\hprose@temptwidth<1sp
		\PackageWarning{hangtext}{Nonpositive twidth ignored}%
		\hprose@temptwidth=\maxdimen
	\fi
}

% env
\def\hprose{%
	\@ifnextchar[{\hprose@withopt}{\hprose@noopt}%
}
\def\hprose@withopt[#1]{%
	\hprose@temphindent=\hprose@hindent@default
	\hprose@tempvspace=\hprose@vspace@default
	\hprose@temptwidth=\hprose@twidth@default
	\def\hprose@tempjustification{}%
	\hangtext@setkeys{hprose}{#1}%
	\hprose@checkmode
}
\def\hprose@noopt{%
	\hprose@temphindent=\hprose@hindent@default
	\hprose@tempvspace=\hprose@vspace@default
	\hprose@temptwidth=\hprose@twidth@default
	\def\hprose@tempjustification{}%
	\hprose@checkmode
}

% check if we need minipage wrapper
\def\hprose@checkmode{%
	\hprose@useminipagefalse
	\ifvmode\else
	\ifdim\hprose@temptwidth<\maxdimen
	\hprose@useminipagetrue
	\fi
	\fi
	\ifhprose@useminipage
	\hprose@startminipage
	\else
	\hprose@start
	\fi
}

% minipage wrapper
\def\hprose@startminipage{%
	\begin{minipage}{\hprose@temptwidth}%
	\hangtext@resethang
	\hprose@start
}
\def\endhprose@minipage{%
	\hprose@end
	\end{minipage}%
}

\def\hprose@start{%
	\par
	\edef\hprose@savedvspace{\the\hprose@tempvspace}%
	\edef\hprose@savedhsize{\the\hsize}%
	\edef\hprose@savedlinewidth{\the\linewidth}%
	\edef\hprose@savedtextwidth{\the\textwidth}%
	\edef\hprose@savedcolumnwidth{\the\columnwidth}%
	\ifvmode\addvspace{\hprose@tempvspace}\fi
	% apply width constraint if specified; do this early
	\ifdim\hprose@temptwidth<\maxdimen
	\hsize=\hprose@temptwidth\relax
	\linewidth=\hprose@temptwidth\relax
	\textwidth=\hprose@temptwidth\relax
	\columnwidth=\hprose@temptwidth\relax
	\fi
	\edef\hprose@savedcumulativehang{\the\cumulativehang}%
	% only capture base state if we are top level
	\ifdim\cumulativehang=0pt
	\setlength{\baseleftskip}{\leftskip}%
	% base text edge for child lists
	\edef\hangtext@basetextedge{\the\dimexpr\@totalleftmargin+\leftskip\relax}%
	\fi
	% save paragraph parameters to restore later
	\edef\hprose@savedtotalleftmargin{\the\@totalleftmargin}%
	\edef\hprose@savedparindent{\the\parindent}%
	\edef\hprose@savedrightskip{\the\rightskip}%
	\edef\hprose@savedparfillskip{\the\parfillskip}%
	\edef\hprose@savedspaceskip{\the\spaceskip}%
	\edef\hprose@savedxspaceskip{\the\xspaceskip}%
	% save and set up everypar
	\hprose@saved@everypar=\expandafter{\the\everypar}%
	% advance cumulativehang first
	\advance\cumulativehang by \hprose@temphindent\relax
	\leftskip=\dimexpr\baseleftskip+\cumulativehang\relax
	\parindent=-\hprose@temphindent\relax
	% activate the child-measure reduction for this level
	\advance\hangtext@activelevel by 1\relax
	\advance\linewidth by -\hprose@temphindent\relax
	% inform nested display material about the container's left edge
	\setlength{\@totalleftmargin}{\dimexpr\hangtext@basetextedge+\cumulativehang\relax}%
	% first-paragraph flag
	\hprose@firstpartrue
	\everypar{%
		\ifhprose@firstpar
			\hprose@firstparfalse
			\parindent=0pt\relax
		\fi
	}%
	% justification without disturbing leftskip
	\def\@tempa{raggedright}%
	\ifx\hprose@tempjustification\@tempa
	\rightskip=0pt plus 2em\relax
	\parfillskip=0pt plus 1fil\relax
	\spaceskip=.3333em\relax
	\xspaceskip=.5em\relax
	\fi
	\def\@tempa{raggedleft}%
	\ifx\hprose@tempjustification\@tempa
	\leftskip=\dimexpr\baseleftskip+\cumulativehang\relax plus 2em\relax
	\rightskip=0pt\relax
	\parfillskip=0pt\relax
	\fi
	\def\@tempa{centering}%
	\ifx\hprose@tempjustification\@tempa
	\leftskip=\dimexpr\baseleftskip+\cumulativehang\relax plus 1fil\relax
	\rightskip=0pt plus 1fil\relax
	\parfillskip=0pt\relax
	\fi
	\ignorespaces
}

\def\endhprose{%
	\ifhprose@useminipage
	\endhprose@minipage
	\else
	\hprose@end
	\fi
}

\def\hprose@end{%
	\par
	% restore everypar
	\everypar=\hprose@saved@everypar
	\setlength{\cumulativehang}{\hprose@savedcumulativehang}%
	% restore leftskip to base + restored cumulative hang
	\leftskip=\dimexpr\baseleftskip+\cumulativehang\relax
	% restore list left margin for parent
	\setlength{\@totalleftmargin}{\hprose@savedtotalleftmargin}%
	% restore paragraph parameters
	\parindent=\hprose@savedparindent\relax
	\rightskip=\hprose@savedrightskip\relax
	\parfillskip=\hprose@savedparfillskip\relax
	\spaceskip=\hprose@savedspaceskip\relax
	\xspaceskip=\hprose@savedxspaceskip\relax
	\hsize=\hprose@savedhsize\relax
	\linewidth=\hprose@savedlinewidth\relax
	\textwidth=\hprose@savedtextwidth\relax
	\columnwidth=\hprose@savedcolumnwidth\relax
	\advance\hangtext@activelevel by -1\relax
	\ifnum\hangtext@activelevel<0 \hangtext@activelevel=0\relax\fi
	\ifvmode\addvspace{\hprose@savedvspace}\fi
	\ignorespacesafterend
}

\makeatother

